{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    
    <div>
        {% for label, messages in app.flashes(['success']) %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" style="width=32%;">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <div>
        {{ form(form) }}
    </div>
    
    <br><br>
    <div style="display:flex; gap: 5px; margin-top: 20px;width: 100%; height: 100%;">
        <div>
            {% for file in files %}

            <form action="{{ path('app_import', { 'fileId': file.id }) }}" method="POST">

                <div style="display:flex;align-items:center;justify-content:center;gap:10px;">
                    {{ file.id }}.
                    {{ file.fileName }}

                    {% if 'uploaded' == file.status.value %}
                        <button type="submit">
                            Import
                        </button>

                    {% else %}
                        <p class={{ "import-" ~ file.status.value }}>
                            {{ file.status.value }}
                        </p> 
                    {% endif %}

                <button type="submit" form="delete-file-{{ file.id }}"
                style="color:red;font-weight:bold;background-color:transparent;border:none;cursor:pointer;">
                    X
                </button>
                </div>
            </form>

            <form id="delete-file-{{ file.id }}" action="{{ path('app_delete_file', { 'fileId': file.id }) }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ file.id) }}">
            </form>

            {% endfor %}

        </div>        

    </div>
    
</div>
{% endblock %}

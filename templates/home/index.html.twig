{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    
    <div>
        {% for label, messages in app.flashes(['success']) %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" style="width=32%;">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <div>
        {{ form(form) }}
    </div>
    
    <br><br>
    <div style="display:flex; gap: 5px; margin-top: 20px;width: 100%; height: 100%;">
        {% for file in files %}
        <form action="{{ path('app_import', { 'fileId': file.id }) }}" method="POST">
            <div>
                {{ file.id }}
                {{ file.fileName }}

                <button type="submit">Import</button>
            </div>
        </form>
        
        {% endfor %}

        

    </div>
    
</div>
{% endblock %}

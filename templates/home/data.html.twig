{% extends 'base.html.twig' %}

{% block title %}Imported Data{% endblock %}

{% block body %}

<div>
    <h3>
        File: {{ fileName }}
    </h3>
    
    {% if records %}
        <table class="dataTable">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>IsActive</th>
            </tr>
            {% for record in records %}
                <tr>
                    <td>{{ record.id }}</td>
                    <td>{{ record.name }}</td>
                    <td>{{ record.email }}</td>
                    <td>{{ record.role }}</td>
                    {# turn binary value for isActive in yes / no #}
                    <td>{{ 1 == record.isActive ? 'Yes' : 'No' }}</td>
                </tr>
            {% endfor %}
        </table>

    {% endif %}
    
</div>

{% endblock %}